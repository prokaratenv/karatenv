{
  "name": "engage-social-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/strip-shell.mjs dist-artifact/index.html",
    "preview": "vite preview",
    "test": "vitest run",
    "sync:youtube": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 tsx sync/youtube.ts",
    "report:weekly": "tsx sync/weekly-report.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "idb-keyval": "^6.2.1",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
